{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PatateLand",
  "mainBinaryName": "PatateLand",
  "version": "2.0.0",
  "identifier": "fr.patateland.launcher.rust",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "PatateLand",
        "width": 1280,
        "height": 720,
        "minWidth": 980,
        "minHeight": 552,
        "center": true,
        "decorations": false,
        "backgroundColor": "#14161c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data: https:; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self'; font-src 'self'; img-src 'self' data: https:; connect-src ipc: http://ipc.localhost ws://127.0.0.1:1430 ws://localhost:1430",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "publisher": "PatateLand",
    "shortDescription": "Launcher du serveur Minecraft PatateLand",
    "copyright": "PatateLand",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "category": "Game",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    }
  }
}
