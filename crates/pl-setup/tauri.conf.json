{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PatateLand - Installation",
  "mainBinaryName": "PatateLand - Installation",
  "version": "2.0.0",
  "identifier": "fr.patateland.launcher.rust.setup",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Installation de PatateLand",
        "width": 760,
        "height": 520,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#14161c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "publisher": "PatateLand",
    "copyright": "PatateLand"
  }
}
